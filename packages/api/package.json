{
  "name": "@bnussman/linode-api",
  "version": "0.0.1",
  "type": "module",
  "files": ["dist"],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "download": "bun run ./scripts/download.ts",
    "generate": "openapi-ts",
    "build": "tsdown",
    "build:docs": "typedoc",
    "build:full": "bun run download && bun run generate && bun run build",
    "typecheck": "tsc",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.1",
    "@bnussman/linode-tsconfig": "workspace:*",
    "@types/bun": "latest",
    "msw": "2.14.6",
    "openapi-types": "12.1.3",
    "tsdown": "0.22.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "zod": "4.4.3",
    "@tanstack/react-query": "^5.100.14"
  }
}
