{
  "name": "@bnussman/linode-toolkit-sdk",
  "version": "0.0.1",
  "type": "module",
  "files": ["dist"],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./types": {
      "types": "./dist/types.gen.ts"
    },
    "./zod": {
      "import": "./dist/zod.gen.mjs",
      "types": "./dist/zod.gen.d.mts"
    },
    "./sdk": {
      "import": "./dist/sdk.gen.mjs",
      "types": "./dist/sdk.gen.d.mts"
    },
    "./client": {
      "import": "./dist/client.gen.mjs",
      "types": "./dist/client.gen.d.mts"
    }
  },
  "scripts": {
    "download": "bun run ./scripts/download.ts",
    "generate": "openapi-ts",
    "build": "tsdown",
    "build:docs": "bunx typedoc",
    "build:full": "bun run download && bun run generate && bun run build",
    "docs": "bunx serve docs",
    "check-types": "tsc",
    "test": "vitest --typecheck"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.1",
    "@types/bun": "1.3.13",
    "msw": "2.14.6",
    "openapi-types": "12.1.3",
    "tsdown": "0.22.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "dependencies": {}
}
